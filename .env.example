VITE_VERIFY_URL=https://nft-graffiti-wallwebverify.vercel.app/
VITE_GALLERY_URL=http://localhost:5174
VITE_CONTRACT_ADDRESS=
VITE_RPC_URL=https://rpc-amoy.polygon.technology/
